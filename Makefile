COQMAKEFILE ?= coq_makefile
COQFLAGS := -Q theories Liquid

.PHONY: all rocq extract demo test assumptions check clean
all: rocq

Makefile.coq: _CoqProject
	$(COQMAKEFILE) -f _CoqProject -o $@

rocq: Makefile.coq
	$(MAKE) -f Makefile.coq

# The extracted algorithms: the demonstrations of the lecture (make demo),
# the regression tests of the extract and the differential test of the
# native reference against it (make test).
extract:
	$(MAKE) -C extraction extract

demo:
	$(MAKE) -C extraction run

test:
	$(MAKE) -C extraction test
	$(MAKE) -C reference test

# Every proved contract is closed under the global context: no axioms.
CONTRACTS := theories/Contracts.v

assumptions: rocq
	@mkdir -p checks
	@{ echo '(* Generated by make assumptions from the contracts of this project:'; \
	   echo '   the assumptions of every proved contract.  Not edited by hand. *)'; \
	   echo 'From Liquid Require Import Contracts.'; \
	   sed -n 's/^Theorem \([A-Za-z0-9_]*_holds\).*/Print Assumptions \1./p' $(CONTRACTS); \
	 } > checks/Assumptions.v
	@out=$$(coqc $(COQFLAGS) checks/Assumptions.v); \
	  expected=$$(grep -c '^Print Assumptions' checks/Assumptions.v); \
	  closed=$$(echo "$$out" | grep -c 'Closed under the global context'); \
	  if [ "$$closed" -eq "$$expected" ]; then \
	    echo "assumptions: $$closed contracts closed under the global context"; \
	  else echo "$$out"; echo "assumptions: only $$closed of $$expected contracts are axiom-free"; exit 1; fi

check: rocq assumptions test

clean:
	@if test -f Makefile.coq; then $(MAKE) -f Makefile.coq clean; fi
	@if test -f extraction/Makefile; then $(MAKE) -C extraction clean; fi
	@if test -f reference/Makefile; then $(MAKE) -C reference clean; fi
	rm -f Makefile.coq Makefile.coq.conf .Makefile.coq.d
	rm -rf checks
